{
  "macie_config": {
    "enabled": false,
    "region": "us-east-1",
    "log_retention_days": 90,
    "scan_schedule": "DAILY"
  },
  "s3_buckets": [
    {
      "name": "my-sensitive-data-bucket",
      "scan": true,
      "encryption": {
        "type": "SSE-KMS",
        "key_id": "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012"
      },
      "versioning": true,
      "block_public_access": true,
      "mfa_delete": false
    }
  ],
  "sensitive_data_classifiers": {
    "include_defaults": true,
    "custom_classifiers": [
      "API_KEY",
      "DATABASE_CONNECTION_STRING",
      "PRIVATE_KEY",
      "AUTHENTICATION_CREDENTIALS"
    ]
  },
  "remediation_actions": {
    "auto_encrypt": true,
    "auto_enable_versioning": true,
    "auto_block_public": true,
    "notification": {
      "enabled": true,
      "sns_topic_arn": "arn:aws:sns:us-east-1:123456789012:macie-alerts"
    }
  },
  "kms_settings": {
    "create_key_policy": true,
    "enable_key_rotation": true,
    "rotation_period_days": 90
  },
  "cloudwatch_monitoring": {
    "enable_logs": true,
    "log_group": "/aws/macie/sensitive-data-scan",
    "metric_alarms": true
  }
}
